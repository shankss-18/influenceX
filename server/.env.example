# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-app-name.vercel.app

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/influencex?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secure_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Seeding Credentials
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@influencex.niat.edu
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_ROLE=ADMIN

# Timezone Setting (Fixed to Asia/Kolkata)
TZ=Asia/Kolkata
